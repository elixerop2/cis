import java.io.*;

class practice {
    public static String process(int shift, String line, boolean encrypt) {
        StringBuilder result = new StringBuilder();
        for (char c : line.toCharArray()) {
            int offset = encrypt ? (c + shift) % 256 : (c - shift + 256) % 256;
            result.append((char) offset);
        }
        return result.toString();
    }

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        System.out.println("Menu:\n1: Encryption\n2: Decryption");
        int choice = Integer.parseInt(br.readLine());
        System.out.println("Enter the shift");
        int shift = Integer.parseInt(br.readLine());
        System.out.println("Enter the line");
        String line = br.readLine();
        System.out.println("Result:\n" + process(shift, line, choice == 1));
    }
}
